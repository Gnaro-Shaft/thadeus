# Variables d'environnement du projet — modèle à recopier en `.env`.
#
#     cp .env.example .env    puis renseigner les valeurs
#
# `.env` n'est jamais versionné (voir .gitignore). Ce fichier-ci l'est, et ne
# doit donc contenir que des NOMS et des exemples — jamais une vraie valeur.
#
# Les configs TOML référencent ces variables avec la syntaxe `${NOM}` :
# une variable obligatoire absente fait échouer le chargement avec un message
# qui la nomme, plutôt que de laisser une source de données vide en silence.


# ── Emplacements de données locales ───────────────────────────────────────────
# Ce ne sont pas des secrets, seulement des chemins propres à chaque machine.

# Vault Obsidian (ou tout répertoire de notes Markdown), utilisé par la source
# `obsidian`, le RAG et le fine-tuning personnel. Obligatoire pour ces usages.
THADEUS_VAULT=~/notes

# Racine des livres du domaine public au format texte, servant de jeu
# d'évaluation du français littéraire. Facultatif : sans lui, la section
# Gutenberg de l'évaluation est simplement absente du rapport.
THADEUS_GUTENBERG=~/donnees/gutenberg


# ── Accès aux services ────────────────────────────────────────────────────────

# Jeton Hugging Face. Nécessaire pour les datasets à licence à accepter, et
# pour des limites de débit utilisables en collecte.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Lightning AI, pour un entraînement sur GPU loué. Facultatif.
LIGHTNING_API_KEY=
LIGHTNING_USER_ID=
